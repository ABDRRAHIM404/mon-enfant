# Copy to .env.local; use only a local or synthetic-data development project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Never put a secret/service_role key into NEXT_PUBLIC_* variables.

# Operator-only Resend/Supabase mail setup. Store actual values in ignored
# .env.local or a secret manager, never in NEXT_PUBLIC_* variables.
# Domain-restricted sending key used as the Supabase SMTP password.
RESEND_API_KEY=
# Optional owner-only SMTP smoke test. Only the Resend account's own address
# may receive mail from onboarding@resend.dev. Reuse the operation UUID on retry.
RESEND_TEST_RECIPIENT=
RESEND_SMOKE_OPERATION_ID=
# Separate full-access key for domain verification; do not deploy this key.
RESEND_ADMIN_API_KEY=
RESEND_DOMAIN_ID=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Mon Enfant
AUTH_EMAIL_RATE_LIMIT=30
AUTH_EMAIL_COOLDOWN_SECONDS=60
# Application mail is separate from Supabase Auth SMTP. Disabled unless enabled
# explicitly; never deploy operator/service-role credentials for this worker.
APP_EMAIL_MODE=disabled
APP_EMAIL_WORKER_EMAIL=
APP_EMAIL_WORKER_PASSWORD=
APP_EMAIL_CRON_SECRET=
APP_EMAIL_ALLOWED_RECIPIENT=
APP_EMAIL_SITE_ORIGIN=https://mon-enfant.vercel.app
# Enable verified-domain mode only after provider DNS verification.
APP_EMAIL_FROM_EMAIL=
APP_EMAIL_DOMAIN_VERIFIED=false
# Operator Management API credential; do not deploy this key to the app.
SUPABASE_ACCESS_TOKEN=
